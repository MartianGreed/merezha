# Routes, projections and reactors. Without the identity block there is no
# principal: every route is public and the project serves only loopback.
version = 2

[storage]
backend = "postgres"
application = "%%app_id%%"

[limits]
max_stream_events = 4096
max_state_bytes = 262144          # the notes projection is one state document
max_concurrent = 8

[[commands]]
tag = "CreateNote"
service = "domain"
aggregate = "Note"
access = "public"

[[commands]]
tag = "EditNote"
service = "domain"
aggregate = "Note"
access = "public"

[[commands]]
tag = "ShareNote"
service = "domain"
aggregate = "Note"
access = "public"

[[commands]]
tag = "ArchiveNote"
service = "domain"
aggregate = "Note"
access = "public"

[[queries]]
tag = "ListNotes"
service = "view"
projection = "notes"
access = "public"

[[queries]]
tag = "GetNote"
service = "view"
projection = "notes"
access = "public"

[[projections]]
name = "notes"
service = "view"
initial = { notes = {} }

[[reactors]]
name = "notifier"
service = "notifier"
events = ["NoteShared"]
effects = ["notify", "webhook"]
