          "expr": "(sum(rate(http_server_request_duration_seconds_count{job=~\"$service\", http_route!~\"/health(/.*)?\", http_response_status_code=~\"5..\"}[1h])) or vector(0)) / sum(rate(http_server_request_duration_seconds_count{job=~\"$service\", http_route!~\"/health(/.*)?\"}[1h])) / 0.001",
