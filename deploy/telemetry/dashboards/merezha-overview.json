    {
      "type": "stat",
      "title": "Availability budget burn (1h)",
      "description": "5xx ratio of the last hour divided by the 0.1% error budget, as in job:merezha_http_errors:ratio_rate1h. Above 14.4 (with the 5-minute ratio) pages.",
